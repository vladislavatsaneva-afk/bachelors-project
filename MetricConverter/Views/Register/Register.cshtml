@model MetricConverter.Models.RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<header class="menu">
    <nav>
        <a href="/">Начална страница</a>
    </nav>
    <style>
        body {
            background-image: url('/images/register.jpg');
            background-repeat: no-repeat;
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            transition: background-image 0.6s ease;
        }
    </style>
</header>

<form asp-controller="Register" asp-action="Register" method="post">
    @Html.AntiForgeryToken()  
    <h2>@ViewData["Title"]</h2>

    <div class="form-group">
        <label asp-for="Username">Потребителско име:</label>
        <input asp-for="Username" class="form-control" />
        <span asp-validation-for="Username" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Email">Имейл адрес:</label>
        <input asp-for="Email" class="form-control" type="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Password">Парола:</label>
        <div class="input-group">
            <input asp-for="Password" class="form-control" type="password" id="password" />
            <span class="input-group-text" id="togglePassword" style="cursor: pointer;">
                <i class="fas fa-eye" id="iconPassword"></i>
            </span>
        </div>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ConfirmPassword">Потвърдете паролата:</label>
        <div class="input-group">
            <input asp-for="ConfirmPassword" class="form-control" type="password" id="confirmPassword" />
            <span class="input-group-text" id="toggleConfirmPassword" style="cursor: pointer;">
                <i class="fas fa-eye" id="iconConfirmPassword"></i>
            </span>
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>
	<p>@Html.ValidationSummary(true, "", new { @class = "text-danger" })</p>

    <button type="submit" class="btn btn-primary">Регистрирай се</button>
    <p>Вече имате профил? <a asp-controller="Login" asp-action="Login">Вход</a></p>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleVisibility(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            const type = input.getAttribute("type") === "password" ? "text" : "password";
            input.setAttribute("type", type);
            icon.classList.toggle("fa-eye");
            icon.classList.toggle("fa-eye-slash");
        }

        document.getElementById("togglePassword").addEventListener("click", function () {
            toggleVisibility("password", "iconPassword");
        });
        document.getElementById("toggleConfirmPassword").addEventListener("click", function () {
            toggleVisibility("confirmPassword", "iconConfirmPassword");
        });
    </script>
}


