@model MetricConverter.Models.AdminModel

<!DOCTYPE html>
<html lang="en">
<head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Потребители</title>
    <style>
        body {
            background-image: url('/images/admin.jpg');
            background-repeat: no-repeat;
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            transition: background-image 0.6s ease;
        }
    </style>
</head>

<body>
    <header class="menu">
        <nav>
            <a href="/">Начална страница</a>
            <a href="/">Изход от профил</a>
        </nav>
    </header>

<table class="table">
    <thead>
        <tr>
            <th colspan="3" style="text-align: center; font-size: 1.5em; padding: 10px 0;">Потребители</th>
        </tr>
        <tr>
            <th>Име</th>
            <th colspan="2" style="text-align: center; font-size: 1.5em; padding: 10px 0;">Действия</th>
        </tr>               
    </thead>
    <tbody>
        @foreach (var user in Model.Users)
        {
            <tr>
                <td>@user.UserName</td>
                <td>
                    <form asp-action="EditUser" method="get" style="display:inline">
                        <input type="hidden" name="username" value="@user.UserName" />
                        <button type="submit" class="btn btn-link p-0 m-0 align-baseline">Редактирай</button>
                    </form> |
                    <form asp-action="DeleteUser" method="post" style="display:inline">
                        <input type="hidden" name="username" value="@user.UserName" />
                        <button type="submit" onclick="return confirm('Сигурни ли сте, че искате да изтриете потребителя?');" class="btn btn-link p-0 m-0 align-baseline">Изтрий</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<table class="table">
    <thead>
        <tr>
            <th colspan="10" style="text-align: center; font-size: 1.5em; padding: 10px 0;">История на преобразуванията</th>
        </tr>
        <tr>
            <th>Потребител</th>
            <th>Категория</th>
            <th>Стойност</th>
            <th>От</th>
            <th>В</th>
            <th>Резултат</th>
            <th>Дата</th>
            <th colspan="2" style="text-align: center; font-size: 1.5em; padding: 10px 0;">Действия</th>
        </tr>                       
    </thead>
    <tbody>
        @foreach (var entry in Model.ConversionHistoryEntries)
        {
            <tr>
                <td>@entry.User?.UserName</td>   
                <td>@entry.ConversionType</td>
                <td>@entry.InputValue</td>
                <td>@entry.FromUnit</td>
                <td>@entry.ToUnit</td>
                <td>@entry.Result</td>
                <td>@entry.DateTime.ToString("dd.MM.yyyy HH:mm")</td>                   
                <td>
                    <form asp-action="DeleteHistory" method="post" style="display:inline">
                        <input type="hidden" name="id" value="@entry.ID" />
                        <button type="submit" onclick="return confirm('Сигурни ли сте, че искате да изтриете този запис?');" class="btn btn-link p-0 m-0 align-baseline">Изтрий</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<table class="table">
    <thead>
        <tr>
            <th colspan="5" style="text-align: center; font-size: 1.5em; padding: 10px 0;">Съобщения до администратора</th>
        </tr>
        <tr>
            <th>Потребител</th>
            <th>Съобщение</th>
            <th>Дата</th>
            <th>Прочетено</th>
            <th colspan="2" style="text-align: center; font-size: 1.5em; padding: 10px 0;">Действия</th>
            </tr>
    </thead>
    <tbody>
        @foreach (var noti in Model.UserNotifications)
        {
            <tr>
                <td>@(noti.User?.UserName ?? "непознат")</td>
                <td>@noti.Message</td>
                <td>@noti.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                <td> @(noti.IsRead ? "Да" : "Не") </td>
                <td>
                    @if (!noti.IsRead)
                    {
                        <form asp-action="MarkAsRead" asp-route-id="@noti.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-success">Маркирай като прочетено</button>
                        </form>
                    }
                    else
                    { <span class="text-muted">Прочетено</span> }
                    |
                    <form asp-action="DeleteNoti" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@noti.Id" />
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Сигурни ли сте, че искате да изтриете този запис?');">Изтрий</button>
                    </form> 
                </td>
            </tr>
        }      
    </tbody>
</table>

</body>
</html>