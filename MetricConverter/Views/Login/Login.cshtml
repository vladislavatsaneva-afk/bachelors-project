@model MetricConverter.Models.LoginModel
@{
    ViewData["Title"] = "Вход в профил";
}

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Конвертор</title>
    <style>
        body {
            background-image: url('/images/login.jpg');
            background-repeat: no-repeat;
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            transition: background-image 0.6s ease;
        }
    </style>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body>
    <header class="menu">
        <nav>
            <a href="/">Начална страница</a>
        </nav>
    </header>

<div class="main-content">
    <div class="form-container">
        <form asp-controller="Login" asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <h2>Вход в профил</h2>
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                <label for="Username">Потребителско име:</label>
                <input asp-for="Username" class="form-control" id="usernameInput" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label for="Password">Парола:</label>
                <div class="input-group">
                    <input asp-for="Password" class="form-control" type="password" id="loginPassword" />
                    <span class="input-group-text" id="toggleLoginPassword" style="cursor: pointer;">
                        <i class="fas fa-eye" id="iconLoginPassword"></i>
                    </span>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Вход</button>

			<p>Нямате профил? <a asp-controller="Register" asp-action="Register">Регистрация</a></p>
            <p>Забравена парола? <a asp-controller="Login" asp-action="ForgotPass">Кликнете тук</a></p>          
        </form>

        <form asp-controller="Login" asp-action="SendMessageToAdmin" method="post">
            @Html.AntiForgeryToken()
            <h4>Желаете да изпратите съобщение до администратор?</h4>
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                <label for="Username">Вашето потребителско име:</label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label for="NotiMessage">Вашето съобщение до администратора:</label>
                <textarea asp-for="NotiMessage" class="form-control" rows="4" placeholder="Напишете съобщение..."></textarea>
                <span asp-validation-for="NotiMessage" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-warning">Изпращане</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById("toggleLoginPassword").addEventListener("click", function () {
            const input = document.getElementById("loginPassword");
            const icon = document.getElementById("iconLoginPassword");
            const type = input.getAttribute("type") === "password" ? "text" : "password";
            input.setAttribute("type", type);
            icon.classList.toggle("fa-eye");
            icon.classList.toggle("fa-eye-slash");
        });
    </script>
}
</body>
</html>
